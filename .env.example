# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (única fuente de verdad móvil + web) ─────
# Sin estas variables la app arranca en MODO DEMO (datos en memoria).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth opcionales (habilitar en dashboard Supabase):
# - Anonymous sign-in
# - Email magic link
# - Google OAuth

# ─── Admin ─────────────────────────────────────────────
# Header x-admin-secret / panel /admin
ADMIN_SECRET=demo-admin

# ─── Cloudinary (fotos) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: unsigned preset
CLOUDINARY_UPLOAD_PRESET=

# ─── Web Push (VAPID) ──────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── Mapas ─────────────────────────────────────────────
# Por defecto OSM tiles vía Leaflet (sin token).
# Si usas MapTiler / MapLibre propios:
# NEXT_PUBLIC_MAP_STYLE_URL=
