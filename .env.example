# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (única fuente de verdad móvil + web) ─────
# Sin estas variables la app arranca en MODO DEMO (datos en memoria).
#
# Canónicas (Cursor Secrets, Flutter assets/env/.env, server):
SUPABASE_URL=https://sxvuovnetndhtfrtgenc.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
#
# Espejos Next.js (navegador). Local: copia los mismos valores.
# En Cursor App Secrets NO declares NEXT_PUBLIC_* (reservados);
# next.config.ts mapea SUPABASE_* → NEXT_PUBLIC_* en build.
NEXT_PUBLIC_SUPABASE_URL=https://sxvuovnetndhtfrtgenc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
#
# Solo servidor (nunca móvil ni NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth opcionales (habilitar en dashboard Supabase):
# - Anonymous sign-in
# - Email magic link
# - Google OAuth

# ─── Admin / SUPER_ADMIN ───────────────────────────────
# Header x-admin-secret / panel /admin
ADMIN_SECRET=demo-admin
# Email del SUPER_ADMIN (Ence). Sin hardcodear secretos.
# Tras crear el usuario en Auth, promociona con:
#   SELECT public.promote_super_admin_by_email('tu@email.com');
# O: UPDATE profiles SET role = 'super_admin' WHERE email = lower('…');
# En el panel, introduce el mismo email en el campo SUPER_ADMIN_EMAIL.
SUPER_ADMIN_EMAIL=

# ─── Cloudinary (fotos — free tier) ────────────────────
# Preferido: unsigned upload (sin API secret en el cliente).
# 1) cloudinary.com → Settings → Upload → Add upload preset (Unsigned)
# 2) Folder sugerida: quejas-vecinales
# 3) Rellena cloud name + preset. Sin claves → demo (data URL / placeholder).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Opcional: signed server-side (destroy de fotos inapropiadas)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Web Push (VAPID) ──────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── Mapas ─────────────────────────────────────────────
# Por defecto OSM tiles vía Leaflet (sin token).
# Si usas MapTiler / MapLibre propios:
# NEXT_PUBLIC_MAP_STYLE_URL=
