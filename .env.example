# Copia este archivo a .env.local. Next.js lee .env.local, no este ejemplo.
# No pongas claves reales aquí: este archivo sí puede subirse a git.

# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (única fuente de verdad móvil + web) ─────
# Sin estas variables la app arranca en MODO DEMO (datos en memoria).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth opcionales (habilitar en dashboard Supabase):
# - Anonymous sign-in
# - Email magic link
# - Google OAuth

# ─── Admin ─────────────────────────────────────────────
# Header x-admin-secret / panel /admin
ADMIN_SECRET=demo-admin

# ─── Correo saliente (aprobación → administración) ─────
# Gmail: SMTP_HOST=smtp.gmail.com, puerto 587 y una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Copia oculta de cada envío (opcional)
ADMIN_NOTIFY_EMAIL=

# ─── Cloudinary (fotos) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: unsigned preset
CLOUDINARY_UPLOAD_PRESET=

# ─── Web Push (VAPID) ──────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.es

# ─── App Android (Play Store) ──────────────────────────
# La app abre esta web. Tiene que ser https público antes de subirla a Play.
# CAPACITOR_SERVER_URL=https://tu-dominio.es
# Huellas SHA-256 del certificado de firma, separadas por comas.
# ANDROID_SHA256_CERT_FINGERPRINTS=

# ─── Mapas ─────────────────────────────────────────────
# Por defecto OSM tiles vía Leaflet (sin token).
# Si usas MapTiler / MapLibre propios:
# NEXT_PUBLIC_MAP_STYLE_URL=
