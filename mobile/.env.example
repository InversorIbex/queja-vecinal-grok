# ─── QuejasVecinales — Flutter ─────────────────────────
# Copia a assets/env/.env y rellena (gitignored).
# Sin claves → MODO DEMO vía assets/env/default.env.
# Nunca commits assets/env/.env ni claves reales.

# Supabase (misma instancia que la web Next.js)
# URL del proyecto real (la clave publishable/anon NO va al repo):
SUPABASE_URL=https://sxvuovnetndhtfrtgenc.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Auth opcionales (activar en dashboard Supabase):
# - Anonymous sign-in
# - Email magic link / password
# - Google OAuth (añadir redirect: io.supabase.quejasvecinales://login-callback/)

# Cloudinary (fotos). Sin preset, las fotos se quedan locales / data URI en demo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Deep links
APP_LINK_HOST=quejasvecinales.app

# Firebase Cloud Messaging (push nativas)
# 1) Añade google-services.json (Android) y GoogleService-Info.plist (iOS)
# 2) flutterfire configure
# Sin Firebase → PushService opera en stub (loguea tokens, no envía).
FCM_ENABLED=false
